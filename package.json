{
  "name": "pi-subagents-hub",
  "version": "2026.10.18-r4",
  "type": "module",
  "description": "A pi extension that brings Claude Code-like sub-agents and workflow orchestration to pi — parallel execution, live widget, fleet view, custom agent types, mid-run steering, dynamic workflows, Claude Code compatibility, look and feel.",
  "author": "ahati",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahati/pi-subagents-hub.git"
  },
  "homepage": "https://github.com/ahati/pi-subagents-hub#readme",
  "bugs": {
    "url": "https://github.com/ahati/pi-subagents-hub/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.1.0",
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "nanoid": "^5.1.16"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "tsc --noCheck 2>/dev/null || npx --yes -p typescript@^6 tsc --noCheck",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:ab": "node test/perf/ab.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typebox": "^1.3.27",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "video": "https://github.com/ahati/pi-subagents-hub/raw/master/media/demo.mp4",
    "image": "https://github.com/ahati/pi-subagents-hub/raw/master/media/Screenshot-Hub-FC.png"
  }
}
